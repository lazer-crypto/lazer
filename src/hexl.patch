diff --git a/hexl/util/cpu-features.hpp b/hexl/util/cpu-features.hpp
index ba40839..88ab512 100644
--- a/hexl/util/cpu-features.hpp
+++ b/hexl/util/cpu-features.hpp
@@ -7,7 +7,9 @@
 
 #include <cstdlib>
 
+#if defined(__x86_64__) || defined(_M_X64)
 #include "cpuinfo_x86.h"  // NOLINT(build/include_subdir)
+#endif
 
 namespace intel {
 namespace hexl {
@@ -20,6 +22,7 @@ static const bool disable_avx512ifma =
 static const bool disable_avx512vbmi2 =
     disable_avx512dq || (std::getenv("HEXL_DISABLE_AVX512VBMI2") != nullptr);
 
+#if defined(__x86_64__) || defined(_M_X64)
 static const cpu_features::X86Features features =
     cpu_features::GetX86Info().features;
 
@@ -30,6 +33,12 @@ static const bool has_avx512ifma = features.avx512ifma && !disable_avx512ifma;
 
 static const bool has_avx512vbmi2 =
     features.avx512vbmi2 && !disable_avx512vbmi2;
+#else
+// Non-x86 targets (e.g. arm64): no AVX512, use the portable code paths.
+static const bool has_avx512dq = false;
+static const bool has_avx512ifma = false;
+static const bool has_avx512vbmi2 = false;
+#endif
 
 }  // namespace hexl
 }  // namespace intel
diff --git a/hexl/include/hexl/util/gcc.hpp b/hexl/include/hexl/util/gcc.hpp
index 828e383..ba067a4 100644
--- a/hexl/include/hexl/util/gcc.hpp
+++ b/hexl/include/hexl/util/gcc.hpp
@@ -55,7 +55,8 @@ inline uint64_t MultiplyUInt64Hi(uint64_t x, uint64_t y) {
 
 // Returns most-significant bit of the input
 inline uint64_t MSB(uint64_t input) {
-  return static_cast<uint64_t>(std::log2l(input));
+  // not log2l: long double is only 64-bit on some targets (e.g. arm64)
+  return static_cast<uint64_t>(63 - __builtin_clzll(input));
 }
 
 #define HEXL_LOOP_UNROLL_4 _Pragma("GCC unroll 4")
